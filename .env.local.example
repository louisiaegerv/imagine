OPENAI_API_KEY=your_openai_api_key_here

# Optional: where images/ and data/ are stored (defaults to the project root)
# LIBRARY_DIR=C:\Users\you\Pictures\imagine

# Optional: longest edge (px) reference images are shrunk to before being sent to
# OpenAI, which bills by pixels. Default 512; 0 sends originals untouched.
# IMAGE_INPUT_MAX_EDGE=512
